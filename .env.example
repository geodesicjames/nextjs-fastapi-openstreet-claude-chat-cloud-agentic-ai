# Copy to .env and adjust:  cp .env.example .env
# .env is gitignored. Never commit real secrets. This file holds only
# local-development placeholders.

# --- Postgres (used by docker-compose's db service) ---------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# --- Backend (FastAPI) ---------------------------------------------------------
ENVIRONMENT=development
# Used when running the backend on your host (uv run ...). Inside Docker
# Compose, the backend service overrides this to point at the `db` service.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
# Public URL of the Next.js app. Sign-in links point at it.
FRONTEND_URL=http://localhost:3000
# Chat access: invite_only (needs a chat grant) or open (any signed-in user).
CHAT_MODE=invite_only
# Daily token budget (input + output) for grants without their own limit.
CHAT_DEFAULT_DAILY_TOKENS=50000
# Map data: public OpenStreetMap services require an identifying User-Agent.
# Put a URL or email where you can be reached (sent only to OSM services).
OSM_CONTACT=
# Public Overpass instance. The main one (https://overpass-api.de/api/interpreter)
# is often at capacity; others are listed at
# https://wiki.openstreetmap.org/wiki/Overpass_API#Public_Overpass_API_instances
OVERPASS_URL=https://ovp.dresel.systems/api/interpreter

# --- Frontend (Next.js) --------------------------------------------------------
# Server-side only (no NEXT_PUBLIC_ prefix), so it is never sent to the browser.
# Inside Docker Compose the frontend service overrides this to http://backend:8000.
API_URL=http://localhost:8000
# Map tiles: MapLibre style URL. Defaults to OpenFreeMap (no key needed). A
# keyed provider's URL is fine here: tile keys are public by design.
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
