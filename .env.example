# Copy to .env and adjust:  cp .env.example .env
# .env is gitignored. Never commit real secrets. This file holds only
# local-development placeholders.

# --- Postgres (used by docker-compose's db service) ---------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# --- Backend (FastAPI) ---------------------------------------------------------
ENVIRONMENT=development
# Used when running the backend on your host (uv run ...). Inside Docker
# Compose, the backend service overrides this to point at the `db` service.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
# Public URL of the Next.js app. Sign-in links point at it.
FRONTEND_URL=http://localhost:3000

# --- Frontend (Next.js) --------------------------------------------------------
# Server-side only (no NEXT_PUBLIC_ prefix), so it is never sent to the browser.
# Inside Docker Compose the frontend service overrides this to http://backend:8000.
API_URL=http://localhost:8000
